PORT=5004
MONGODB_URI=mongodb://127.0.0.1:27017/careerforge
JWT_SECRET=replace-with-a-long-random-secret
CLIENT_URL=http://localhost:5173
# Keep this disabled until an isolated, authenticated code-judge provider is integrated.
# Never run untrusted learner code in the CareerForge API process.
CODE_EXECUTION_PROVIDER=disabled
# Optional server-side LLM configuration for CareerForge Copilot.
# Leave both AI_PROVIDER and AI_API_KEY blank to use the reliable local Copilot.
# Supported provider: openai
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=gpt-4.1-mini

# Optional social sign-in. Keep secrets on the server only.
# Register callback: OAUTH_PUBLIC_ORIGIN/api/auth/oauth/google/callback
# Register callback: OAUTH_PUBLIC_ORIGIN/api/auth/oauth/github/callback
OAUTH_PUBLIC_ORIGIN=http://127.0.0.1:5173
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Password-recovery email via Gmail SMTP. Use a Google App Password, not your normal Gmail password.
# Enable 2-Step Verification, create an App Password, then set these values only in the backend .env file.
# Never expose SMTP_PASS in the frontend or commit it to Git.
PASSWORD_RESET_ORIGIN=http://127.0.0.1:5173
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-16-character-google-app-password
SMTP_FROM=CareerForge <your-gmail-address@gmail.com>
